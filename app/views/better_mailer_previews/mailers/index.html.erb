<% mailers = @urls_by_mailer.reject { |_name, urls| urls.empty? } %>

<div class="max-w-[1800px] mx-auto">
  <header class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h1 class="text-4xl font-semibold tracking-tight">Better Mailer Previews</h1>
    <span class="text-xs text-gray-400 font-mono">v<%= BetterMailerPreviews::VERSION::STRING %></span>
    <span class="text-sm text-gray-500">
      <%= pluralize(mailers.size, "mailer") %>, <%= pluralize(mailers.values.sum(&:size), "preview") %>
    </span>
  </header>

  <% if mailers.empty? %>
    <div class="mt-10 border border-dashed border-gray-300 bg-white rounded-lg p-10 text-center">
      <p class="text-lg font-medium">No mailer previews found</p>
      <p class="mt-2 text-sm text-gray-500">
        Define an <code class="font-mono">ActionMailer::Preview</code> class under your preview path
        and it will show up here.
      </p>
    </div>
  <% else %>
    <nav class="sticky top-0 z-20 -mx-2 mt-6 px-2 py-3 bg-gray-50/90 backdrop-blur border-b border-gray-200">
      <ul class="flex flex-wrap gap-2">
        <% mailers.each do |mailer_name, urls| %>
          <li>
            <a href="#<%= mailer_name %>"
               class="inline-flex items-baseline gap-1.5 rounded-full border border-gray-300 bg-white px-3 py-1
                      text-sm text-gray-700 hover:border-gray-500 hover:text-gray-900 transition-colors">
              <%= mailer_name.titleize %>
              <span class="text-xs text-gray-400 font-mono"><%= urls.size %></span>
            </a>
          </li>
        <% end %>
      </ul>
    </nav>

    <% mailers.each do |mailer_name, urls| %>
      <section id="<%= mailer_name %>" class="mt-12 scroll-mt-20">
        <h2 class="flex items-baseline gap-2 pb-2 border-b border-gray-200">
          <span class="text-xl font-medium tracking-tight"><%= mailer_name.titleize %></span>
          <span class="text-xs text-gray-400 font-mono"><%= mailer_name %></span>
        </h2>

        <div class="bmp-grid mt-6">
          <% urls.each do |url| %>
            <% label = preview_email_label(url) %>
            <article class="group">
              <div class="bmp-thumb rounded-md border border-gray-300 shadow-sm
                          group-hover:border-gray-500 group-hover:shadow-md transition-all">
                <iframe src="<%= preview_body_url(url) %>" title="<%= preview_text_for_url(url) %>" loading="lazy" tabindex="-1"></iframe>
                <%# The iframe swallows clicks, so the link is an overlay on top of it. %>
                <a class="bmp-hit" href="<%= preview_path_for_url(url) %>" aria-label="<%= preview_text_for_url(url) %>"></a>
              </div>
              <%# Two lines rather than a truncation: the tail of the name is exactly what %>
              <%# distinguishes two neighbouring previews. The reserved height keeps the rows even. %>
              <a href="<%= preview_path_for_url(url) %>"
                 class="mt-2 block min-h-[2.5rem] text-sm leading-5 text-gray-700
                        group-hover:text-gray-900 group-hover:underline line-clamp-2"
                 title="<%= label %>"><%= label %></a>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
  <% end %>

  <%= render "footer" %>
</div>
